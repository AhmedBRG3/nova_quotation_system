@page
@model Inova.Quotations.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash">@Model.Flash</div>
}

<div class="page-head">
    <h1>Settings</h1>
</div>

<form method="post" enctype="multipart/form-data">
    <div class="card">
        <h2>Agency details — printed in the footer</h2>
        <div class="grid2">
            <div class="field">
                <label asp-for="Input.Name">Company name <span class="req">*</span></label>
                <input asp-for="Input.Name" />
                <span asp-validation-for="Input.Name" class="validation-message"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Address">Address</label>
                <input asp-for="Input.Address" />
            </div>
            <div class="field">
                <label asp-for="Input.Phone">Phone</label>
                <input asp-for="Input.Phone" />
            </div>
            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" />
            </div>
            <div class="field">
                <label asp-for="Input.Website">Website</label>
                <input asp-for="Input.Website" />
            </div>
            <div class="field">
                <label asp-for="Input.TaxNumber">Tax registration number</label>
                <input asp-for="Input.TaxNumber" placeholder="123-456-789" />
                <span class="hint">Printed in the quotation header. Leave empty to hide the row.</span>
                <span asp-validation-for="Input.TaxNumber" class="validation-message"></span>
            </div>
            <div class="field">
                <label asp-for="Input.DefaultVatPercent">Default VAT %</label>
                <input asp-for="Input.DefaultVatPercent" type="number" step="0.01" min="0" max="100" />
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Logo</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Input.LogoPath))
        {
            <div style="display:flex; align-items:center; gap:18px; margin-bottom:14px;">
                <img src="@Model.Input.LogoPath" alt="Current logo" style="max-width:220px; height:auto; border:1px solid var(--line); padding:8px; background:#fff;" />
                <button class="btn ghost" type="submit" asp-page-handler="ClearLogo" formnovalidate>Remove logo</button>
            </div>
        }
        else
        {
            <p style="color:var(--muted); margin-top:0">
                No logo uploaded — the quotation prints the red <strong>NOVA</strong> text wordmark instead.
                Upload the real logo to replace it.
            </p>
        }
        <div class="field">
            <label asp-for="LogoFile">Upload logo</label>
            <input asp-for="LogoFile" type="file" accept="image/*" />
            <span class="hint">PNG with a transparent background works best. Printed 50 mm wide.</span>
            <span asp-validation-for="LogoFile" class="validation-message"></span>
        </div>
    </div>

    <div class="card">
        <h2>Default terms &amp; conditions</h2>
        <div class="field">
            <label asp-for="Input.DefaultTerms">Loaded into every new quotation, then editable per job</label>
            <textarea asp-for="Input.DefaultTerms" rows="9"></textarea>
            <span class="hint">
                One clause per line. Text after a <strong>|</strong> becomes the Arabic column:
                <code>Valid for 30 days. | صالح لمدة ٣٠ يوماً.</code>
            </span>
        </div>
    </div>

    <div class="page-head">
        <span class="spacer"></span>
        <button class="btn" type="submit">Save settings</button>
    </div>
</form>
