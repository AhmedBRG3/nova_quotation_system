<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — NOVA Quotations</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="brand">NOVA<small>Marketing &amp; Advertising</small></div>
        <nav>
            <a asp-page="/Index">Quotations</a>
            <a asp-page="/PurchaseOrders/Index">Purchase Orders</a>
            <a asp-page="/Settings">Settings</a>
        </nav>
        <span class="spacer"></span>
        @* The primary action follows the section you are in, so the Purchase Orders tab
           never offers "new quotation" as its most prominent button. *@
        @if ((ViewContext.HttpContext.Request.Path.Value ?? "").StartsWith("/PurchaseOrders", StringComparison.OrdinalIgnoreCase))
        {
            <a class="btn sm" asp-page="/PurchaseOrders/Edit">+ New purchase order</a>
        }
        else
        {
            <a class="btn sm" asp-page="/Quotations/Edit">+ New quotation</a>
        }
    </header>

    <main class="wrap">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
