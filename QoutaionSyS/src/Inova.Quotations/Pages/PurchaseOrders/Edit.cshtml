@page "/PurchaseOrders/Edit/{id:int?}"
@model Inova.Quotations.Pages.PurchaseOrders.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New purchase order" : Model.Input.PoNo;
}

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="flash">@Model.Flash</div>
}

<form method="post" id="po-form">
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.QuotationId" />

    <div class="page-head">
        <h1>@(Model.IsNew ? "New purchase order" : $"Purchase order {Model.Input.PoNo}")</h1>
        <span class="spacer"></span>
        @if (!Model.IsNew)
        {
            <a class="btn ghost" asp-page="/PurchaseOrders/Print" asp-route-id="@Model.Input.Id" target="_blank">Preview</a>
            <a class="btn dark" href="/purchase-orders/@Model.Input.Id/pdf">Download PDF</a>
        }
        <button class="btn" type="submit">Save</button>
    </div>

    @if (Model.QuotationJobNo is not null)
    {
        <div class="flash revision">
            Procuring for quotation
            <strong><a asp-page="/Quotations/Edit" asp-route-id="@Model.Input.QuotationId">@Model.QuotationJobNo</a></strong>
            — line items were copied across with prices cleared, so enter what the <em>vendor</em> charges.
        </div>
    }

    @* "All", not "ModelOnly": there is no client-side validation here, so a missing required
       field would otherwise only show as a small note far down the page — the save looks
       like it silently did nothing. *@
    @* No class here on purpose: the tag helper stamps validation-summary-errors only when
       something actually failed, and validation-summary-valid otherwise. Hardcoding the
       error class would style a clean form as if it had errors. *@
    <div asp-validation-summary="All"></div>

    <div class="card">
        <h2>Purchase order details</h2>
        <div class="grid3">
            <div class="field">
                <label asp-for="Input.PoNo">PO No. <span class="req">*</span></label>
                <input asp-for="Input.PoNo" />
                <span asp-validation-for="Input.PoNo" class="validation-message"></span>
            </div>
            <div class="field">
                <label asp-for="Input.PoDate">Date <span class="req">*</span></label>
                <input asp-for="Input.PoDate" type="date" />
                <span asp-validation-for="Input.PoDate" class="validation-message"></span>
            </div>
            <div class="field">
                <label asp-for="Input.VatPercent">VAT % <span class="req">*</span></label>
                <input asp-for="Input.VatPercent" type="number" step="0.01" min="0" max="100" id="vat-percent" />
                <span asp-validation-for="Input.VatPercent" class="validation-message"></span>
            </div>
        </div>

        <div class="grid2" style="margin-top:14px">
            <div class="field">
                <label asp-for="Input.SubjectEn">Subject — English <span class="req">*</span></label>
                <input asp-for="Input.SubjectEn" />
                <span asp-validation-for="Input.SubjectEn" class="validation-message"></span>
            </div>
            <div class="field">
                <label asp-for="Input.SubjectAr">الموضوع — Arabic</label>
                <input asp-for="Input.SubjectAr" dir="rtl" />
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Vendor</h2>
        <div class="grid2">
            <div class="field">
                <label asp-for="Input.VendorNameEn">Vendor — English <span class="req">*</span></label>
                <input asp-for="Input.VendorNameEn" />
                <span asp-validation-for="Input.VendorNameEn" class="validation-message"></span>
            </div>
            <div class="field">
                <label asp-for="Input.VendorNameAr">اسم المورد — Arabic</label>
                <input asp-for="Input.VendorNameAr" dir="rtl" />
            </div>
            <div class="field">
                <label asp-for="Input.VendorContactPersonEn">Contact person — English</label>
                <input asp-for="Input.VendorContactPersonEn" />
            </div>
            <div class="field">
                <label asp-for="Input.VendorContactPersonAr">اسم الشخص المسؤول — Arabic</label>
                <input asp-for="Input.VendorContactPersonAr" dir="rtl" />
            </div>
        </div>
        <div class="grid2" style="margin-top:14px">
            <div class="field">
                <label asp-for="Input.VendorContactDetails">Job title / phone</label>
                <input asp-for="Input.VendorContactDetails" placeholder="Sales Manager · +20 100 000 0000" />
            </div>
            <div class="field">
                <label asp-for="Input.VendorTaxNumber">Vendor tax number</label>
                <input asp-for="Input.VendorTaxNumber" />
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Line items</h2>
        <span asp-validation-for="Input.Items" class="validation-message"></span>

        <table class="rows" id="items-table">
            <thead>
                <tr>
                    <th style="width:34px"></th>
                    <th>Description</th>
                    <th style="width:110px">Quantity</th>
                    <th style="width:150px">Unit price</th>
                    <th class="num" style="width:130px">Total</th>
                    <th style="width:44px"></th>
                </tr>
            </thead>
            <tbody id="items-body">
            @for (var i = 0; i < Model.Input.Items.Count; i++)
            {
                <tr class="item-row">
                    <td class="idx"></td>
                    <td>
                        <div class="stack">
                            <textarea asp-for="Input.Items[i].DescriptionEn" rows="2" placeholder="Description (English)"></textarea>
                            <textarea asp-for="Input.Items[i].DescriptionAr" dir="rtl" rows="2" placeholder="البيان (عربي)"></textarea>
                            <span asp-validation-for="Input.Items[i].DescriptionEn" class="validation-message"></span>
                        </div>
                    </td>
                    <td><input asp-for="Input.Items[i].Quantity" class="qty" type="number" step="1.0" min="0" /></td>
                    <td><input asp-for="Input.Items[i].UnitPrice" class="price" type="number" step="1.0" min="0" /></td>
                    <td class="num line-total">0.00</td>
                    <td><button type="button" class="btn sm danger remove-row" title="Remove">✕</button></td>
                </tr>
            }
            </tbody>
        </table>

        <div style="margin-top:12px">
            <button type="button" class="btn ghost" id="add-row">+ Add item</button>
        </div>

        <div class="totals-box">
            <div class="row soft"><span>Total excl. VAT</span><span id="t-excl">0.00</span></div>
            <div class="row soft"><span>VAT <span id="t-vat-pct">14</span>%</span><span id="t-vat">0.00</span></div>
            <div class="row grand"><span>Total incl. VAT</span><span id="t-incl">EGP 0.00</span></div>
        </div>
    </div>

    <div class="card">
        <h2>Terms &amp; conditions</h2>
        <div class="field">
            <label asp-for="Input.Terms">Terms <span class="req">*</span></label>
            <textarea asp-for="Input.Terms" rows="7"></textarea>
            <span class="hint">
                One clause per line. Put the Arabic after a <strong>|</strong> to fill the right-hand column:
                <code>Delivery within 14 days. | التسليم خلال ١٤ يوماً.</code>
            </span>
            <span asp-validation-for="Input.Terms" class="validation-message"></span>
        </div>
    </div>

    <div class="card">
        <h2>Note <span style="color:var(--muted); font-weight:600; letter-spacing:0; text-transform:none">— optional</span></h2>
        <div class="grid2">
            <div class="field">
                <label asp-for="Input.NoteEn">Note — English</label>
                <textarea asp-for="Input.NoteEn" rows="3"></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.NoteAr">ملاحظة — Arabic</label>
                <textarea asp-for="Input.NoteAr" dir="rtl" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="page-head">
        <a class="btn ghost" asp-page="/PurchaseOrders/Index">Back to list</a>
        <span class="spacer"></span>
        <button class="btn" type="submit">Save purchase order</button>
    </div>
</form>

<template id="row-template">
    <tr class="item-row">
        <td class="idx"></td>
        <td>
            <div class="stack">
                <textarea name="Input.Items[__i__].DescriptionEn" rows="2" placeholder="Description (English)"></textarea>
                <textarea name="Input.Items[__i__].DescriptionAr" dir="rtl" rows="2" placeholder="البيان (عربي)"></textarea>
            </div>
        </td>
        <td><input name="Input.Items[__i__].Quantity" class="qty" type="number" step="1.0" min="0" value="1" /></td>
        <td><input name="Input.Items[__i__].UnitPrice" class="price" type="number" step="1.0" min="0" value="0" /></td>
        <td class="num line-total">0.00</td>
        <td><button type="button" class="btn sm danger remove-row" title="Remove">✕</button></td>
    </tr>
</template>

@section Scripts {
<script>
(function () {
    const body     = document.getElementById('items-body');
    const template = document.getElementById('row-template');
    const vatInput = document.getElementById('vat-percent');
    const fmt      = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    // Field names carry their row index, so every add/remove has to renumber them.
    function reindex() {
        body.querySelectorAll('tr.item-row').forEach((row, i) => {
            row.querySelector('.idx').textContent = i + 1;
            row.querySelectorAll('input, textarea').forEach(input => {
                if (input.name) input.name = input.name.replace(/Input\.Items\[\d+\]/, `Input.Items[${i}]`);
                input.removeAttribute('id');
            });
        });
    }

    function recalc() {
        let subtotal = 0;
        body.querySelectorAll('tr.item-row').forEach(row => {
            const qty   = parseFloat(row.querySelector('.qty').value)   || 0;
            const price = parseFloat(row.querySelector('.price').value) || 0;
            const total = Math.round(qty * price * 100) / 100;
            subtotal += total;
            row.querySelector('.line-total').textContent = fmt.format(total);
        });

        const vatPct = parseFloat(vatInput.value) || 0;
        const vat    = Math.round(subtotal * vatPct) / 100;

        document.getElementById('t-excl').textContent    = fmt.format(subtotal);
        document.getElementById('t-vat').textContent     = fmt.format(vat);
        document.getElementById('t-vat-pct').textContent = vatPct;
        document.getElementById('t-incl').textContent    = 'EGP ' + fmt.format(subtotal + vat);
    }

    document.getElementById('add-row').addEventListener('click', () => {
        const count = body.querySelectorAll('tr.item-row').length;
        const html  = template.innerHTML.replaceAll('__i__', count);
        body.insertAdjacentHTML('beforeend', html);
        reindex();
        recalc();
        body.lastElementChild.querySelector('textarea, input').focus();
    });

    body.addEventListener('click', e => {
        if (!e.target.classList.contains('remove-row')) return;
        e.target.closest('tr').remove();
        if (body.querySelectorAll('tr.item-row').length === 0) {
            document.getElementById('add-row').click();
            return;
        }
        reindex();
        recalc();
    });

    document.getElementById('po-form').addEventListener('input', recalc);

    reindex();
    recalc();
})();
</script>
}
